# AI 情感分析系统环境变量配置示例
# 复制此文件为 .env 并根据需要修改（Windows 可在 start.bat/dev.bat 中设置）

# 后端服务地址
AI_EMOTION_SERVER_HOST=127.0.0.1
AI_EMOTION_SERVER_PORT=8000

# CORS 允许的前端来源（逗号分隔）
AI_EMOTION_ALLOWED_ORIGINS=http://localhost:3000

# 内存缓冲（保留最近 N 条识别记录）
AI_EMOTION_EVENT_BUFFER_SIZE=200
AI_EMOTION_MAX_WS_QUEUE_SIZE=200
AI_EMOTION_METRICS_INTERVAL=1.0

# OSC配置（用于与其他应用通信）
AI_EMOTION_OSC_IP=127.0.0.1
AI_EMOTION_OSC_PORT=7000

# LLM模型配置
AI_EMOTION_LLM_MODEL=deepseek-r1:1.5b
AI_EMOTION_LLM_TEMPERATURE=0.6
AI_EMOTION_PROMPT_TEMPLATE=prompt_template.txt

# 语音识别配置
AI_EMOTION_VOSK_MODEL=vosk-model-small-cn
AI_EMOTION_SAMPLE_RATE=16000
AI_EMOTION_BLOCKSIZE=2000

# 语音检测阈值
AI_EMOTION_SILENCE_THRESHOLD=500
AI_EMOTION_MIN_SPEECH_DURATION=0.3
AI_EMOTION_MAX_SILENCE_DURATION=0.5

# Partial 推送节流（秒）
AI_EMOTION_PARTIAL_THROTTLE=0.2
