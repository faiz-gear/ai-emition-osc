{
  "name": "ai-emotion-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "desktop",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run contracts:build && npm run client:build && npm run desktop:build",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "contracts:build": "npm run build --workspace @ai-emotion/contracts",
    "desktop:dev": "npm run dev --workspace desktop",
    "desktop:build": "npm run build --workspace desktop",
    "client:build": "npm run build --workspace client && node -e \"const fs=require('node:fs');fs.rmSync('client-dist',{recursive:true,force:true});fs.cpSync('client/out','client-dist',{recursive:true});\""
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
